<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Three packages:
      - Microsoft.Agents.AI.Foundry          -> Agent Framework over a Foundry project
      - Microsoft.Agents.AI.Foundry.Hosting  -> exposes the agent via the Responses protocol (hosted agent). Prerelease.
      - Azure.Identity                       -> no keys: az login locally, agent identity in Foundry
    Floating versions for the initial restore; pin them once the build succeeds.
  -->
  <PropertyGroup>
    <RootNamespace>AgendaAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ServiceDefaults/ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.*" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.*-*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

</Project>
